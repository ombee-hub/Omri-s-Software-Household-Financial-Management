// Firestore Security Rules for התוכנה של עמרי
// Paste this into Firebase Console:
// https://console.firebase.google.com/project/omri-s-software/firestore/rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any authenticated user can read and write all household data
    // (cards, bills, tasks, docs are shared between Omri and Sapir).
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
