{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/.*/**",
            "config/**",
            "**/node_modules/**",
            "*.md",
            "**/*.xlsx",
            "**/*.xls",
            "**/*.csv",
            "**/~$*"
        ],
        "cleanUrls": false,
        "trailingSlash": false,
        "headers": [
            {
                "source": "**/*.@(html)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "pwa/manifest.json",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "sw.js",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            }
        ]
    },
    "firestore": {
        "rules": "config/firestore.rules"
    }
}
