{
    "hosting": {
        "public": ".",
        "ignore": [
            "firebase.json",
            ".firebaserc",
            ".firebase/**",
            "**/.*",
            "**/node_modules/**",
            "**/scripts/**",
            "server.js",
            "package.json",
            "package-lock.json",
            "firestore.rules",
            "*.md"
        ],
        "cleanUrls": false,
        "trailingSlash": false,
        "headers": [
            {
                "source": "**/*.@(html)",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
                ]
            },
            {
                "source": "manifest.json",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            },
            {
                "source": "sw.js",
                "headers": [
                    { "key": "Cache-Control", "value": "no-cache" }
                ]
            }
        ]
    }
}
