        <main class="main-content">
            <h2 class="dashboard-title">מצב עריכת קלטות</h2>

            <div class="status-container">
                <!-- קלטות לא ערוכות -->
                <div class="status-column not-edited">
                    <div class="column-header">
                        <h3 class="column-title">
                            <span class="column-status-indicator"></span>
                            <span class="column-title-text">לא ערוכות</span>
                        </h3>
                        <span class="status-count" id="not-edited-count">0</span>
                    </div>
                    <div class="column-content" id="notEditedTasks">
                        <div class="no-tasks">אין קלטות בסטטוס זה</div>
                    </div>
                </div>

                <!-- קלטות לפני עריכה -->
                <div class="status-column before-edit">
                    <div class="column-header">
                        <h3 class="column-title">
                            <span class="column-status-indicator"></span>
                            <span class="column-title-text">לפני עריכה</span>
                        </h3>
                        <span class="status-count" id="before-edit-count">1</span>
                    </div>
                    <div class="column-content" id="beforeEditTasks">
                        <div class="task-card">
                            <div class="task-header">
                                <div class="task-title">תיבת נגינה מופע סולונה 2011</div>
                                <div class="task-category">אירועים</div>
                                <div class="task-time">
                                    <div class="task-time-item">
                                        <span class="icon">📅</span>
                                        2025-03-15
                                    </div>
                                    <div class="task-time-item">
                                        <span class="icon">🕒</span>
                                        10:00
                                    </div>
                                </div>
                            </div>
                            <div class="task-description">מופע שירים עם תיבת נגינה</div>
                            <div class="task-people">
                                <div class="task-people-title">אנשים בקלטת:</div>
                                <ul class="people-list">
                                    <li>אייל אבא</li>
                                    <li>איתי סלמן</li>
                                    <li>עמרי בן אליהו</li>
                                    <li>דניאל</li>
                                </ul>
                            </div>
                            <div class="task-actions">
                                <button class="btn btn-primary">
                                    <span class="icon">✏️</span> ערוך
                                </button>
                                <button class="btn btn-success">
                                    <span class="icon">✓</span> העבר לערוך
                                </button>
                                <button class="btn btn-danger">
                                    <span class="icon">🗑️</span> מחק
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- קלטות ערוכות -->
                <div class="status-column edited">
                    <div class="column-header">
                        <h3 class="column-title">
                            <span class="column-status-indicator"></span>
                            <span class="column-title-text">ערוכות</span>
                        </h3>
                        <span class="status-count" id="edited-count">1</span>
                    </div>
                    <div class="column-content" id="editedTasks">
                        <div class="task-card">
                            <div class="task-header">
                                <div class="task-title">עמרי בן 3</div>
                                <div class="task-category">משפחה</div>
                                <div class="task-time">
                                    <div class="task-time-item">
                                        <span class="icon">📅</span>
                                        2025-03-07
                                    </div>
                                    <div class="task-time-item">
                                        <span class="icon">🕒</span>
                                        10:00
                                    </div>
                                </div>
                            </div>
                            <div class="task-description">הילדים המופעים בקלטת הם איין בן דוד מאמריקה, עמרי בן דוד מישראל, נוי בת דודה מישראל</div>
                            <div class="task-converter">
                                <strong>בוצע על ידי:</strong> עמרי
                            </div>
                            <div class="task-actions">
                                <button class="btn btn-primary">
                                    <span class="icon">✏️</span> ערוך
                                </button>
                                <button class="btn btn-danger">
                                    <span class="icon">🗑️</span> מחק
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal for editing -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title">עריכת קלטת</h3>
                <button class="modal-close" onclick="closeEditModal()">&times;</button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editTaskId">
                    
                    <div class="form-group">
                        <label for="editTitle" class="form-label">שם הקלטת</label>
                        <input type="text" id="editTitle" class="form-control" required>
                    </div>
                    
                    <div class="form-group-row">
                        <div class="form-group">
                            <label for="editCategory" class="form-label">קטגוריה</label>
                            <select id="editCategory" class="form-control" required>
                                <option value="family">משפחה</option>
                                <option value="friends">חברים</option>
                                <option value="events">אירועים</option>
                                <option value="other">אחר</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="editStatus" class="form-label">סטטוס עריכה</label>
                            <select id="editStatus" class="form-control" required>
                                <option value="not_edited">לא ערוכה</option>
                                <option value="before_edit">לפני עריכה</option>
                                <option value="edited">ערוכה</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="editDescription" class="form-label">תיאור הקלטת</label>
                        <textarea id="editDescription" class="form-control" rows="3"></textarea>
                    </div>
                    
                    <div class="form-group-row">
                        <div class="form-group">
                            <label for="editDate" class="form-label">תאריך הקלטה</label>
                            <input type="date" id="editDate" class="form-control" required>
                        </div>
                        
                        <div class="form-group">
                            <label for="editTime" class="form-label">שעת הקלטה</label>
                            <select id="editTime" class="form-control">
                                <option value="">בחר שעה</option>
                                <option value="00:00">00:00</option>
                                <option value="01:00">01:00</option>
                                <option value="02:00">02:00</option>
                                <option value="03:00">03:00</option>
                                <option value="04:00">04:00</option>
                                <option value="05:00">05:00</option>
                                <option value="06:00">06:00</option>
                                <option value="07:00">07:00</option>
                                <option value="08:00">08:00</option>
                                <option value="09:00">09:00</option>
                                <option value="10:00">10:00</option>
                                <option value="11:00">11:00</option>
                                <option value="12:00">12:00</option>
                                <option value="13:00">13:00</option>
                                <option value="14:00">14:00</option>
                                <option value="15:00">15:00</option>
                                <option value="16:00">16:00</option>
                                <option value="17:00">17:00</option>
                                <option value="18:00">18:00</option>
                                <option value="19:00">19:00</option>
                                <option value="20:00">20:00</option>
                                <option value="21:00">21:00</option>
                                <option value="22:00">22:00</option>
                                <option value="23:00">23:00</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="editPeople" class="form-label">אנשים שמופיעים בקלטת</label>
                        <textarea id="editPeople" class="form-control" rows="3" placeholder="הזן את שמות האנשים שמופיעים בקלטת, כל שם בשורה חדשה"></textarea>
                    </div>
                    
                    <div class="form-group">
                        <label for="editConverter" class="form-label">בוצע על ידי</label>
                        <input type="text" id="editConverter" class="form-control" placeholder="שם מבצע ההמרה">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeEditModal()">ביטול</button>
                <button type="button" class="btn btn-primary" onclick="saveTaskChanges()">שמור שינויים</button>
            </div>
        </div>
    </div>

    <script>
        // בדיקת התחברות
        document.addEventListener('DOMContentLoaded', function() {
            if (!localStorage.getItem('isLoggedIn')) {
                window.location.href = 'login.html';
            }
        });
        
        // פונקציית התנתקות
        function logout() {
            localStorage.removeItem('isLoggedIn');
            window.location.href = 'login.html';
        }
        
        // פתיחת מודל עריכה
        function openEditModal(taskId) {
            document.getElementById('editModal').style.display = 'flex';
        }
        
        // סגירת מודל עריכה
        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }
        
        // שמירת שינויים
        function saveTaskChanges() {
            // כאן יהיה הקוד לשמירת השינויים
            closeEditModal();
            alert('השינויים נשמרו בהצלחה');
        }
    </script>
</body>
</html>