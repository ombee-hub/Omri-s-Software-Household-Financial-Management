            <div class="filters-container">
                <h3 class="filters-title">סינון קלטות</h3>
                <div class="filters">
                    <div class="filter-group">
                        <label for="categoryFilter" class="filter-label">קטגוריה:</label>
                        <select id="categoryFilter" class="filter-control">
                            <option value="">הכל</option>
                            <option value="family">משפחה</option>
                            <option value="friends">חברים</option>
                            <option value="events">אירועים</option>
                            <option value="other">אחר</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="yearFilter" class="filter-label">שנה:</label>
                        <select id="yearFilter" class="filter-control">
                            <option value="">הכל</option>
                            <option value="2025">2025</option>
                            <option value="2024">2024</option>
                            <option value="2023">2023</option>
                            <option value="2022">2022</option>
                            <option value="2021">2021</option>
                            <option value="2020">2020</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="statusFilter" class="filter-label">סטטוס:</label>
                        <select id="statusFilter" class="filter-control">
                            <option value="">הכל</option>
                            <option value="not_edited">לא ערוכה</option>
                            <option value="before_edit">לפני עריכה</option>
                            <option value="edited">ערוכה</option>
                        </select>
                    </div>
                </div>
                <div class="filter-actions">
                    <button class="btn btn-primary">
                        <span class="icon">🔍</span>
                        החל סינון
                    </button>
                </div>
            </div>

            <div class="gallery-grid" id="galleryContainer">
                <!-- קלטת 1 -->
                <div class="gallery-item">
                    <div class="gallery-thumbnail">
                        <div class="thumbnail-icon">🎞️</div>
                    </div>
                    <div class="gallery-content">
                        <h3 class="gallery-title-item">עמרי בן 3</h3>
                        <div class="gallery-meta">
                            <div class="gallery-meta-item">
                                <span class="icon">📅</span>
                                <span>2025-03-07</span>
                            </div>
                            <div class="gallery-meta-item">
                                <span class="icon">🏷️</span>
                                <span>משפחה</span>
                            </div>
                        </div>
                        <p class="gallery-description">
                            הילדים המופעים בקלטת הם איין בן דוד מאמריקה, עמרי בן דוד מישראל, נוי בת דודה מישראל
                        </p>
                    </div>
                    <div class="gallery-footer">
                        <div class="gallery-status status-edited">ערוכה</div>
                        <a href="#" class="gallery-details" onclick="openModal('1')">
                            פרטים נוספים
                            <span class="icon">→</span>
                        </a>
                    </div>
                </div>

                <!-- קלטת 2 -->
                <div class="gallery-item">
                    <div class="gallery-thumbnail">
