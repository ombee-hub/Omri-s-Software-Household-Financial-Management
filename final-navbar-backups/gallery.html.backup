    <!-- Modal for viewing recording details -->
    <div id="recordingModal" class="modal-overlay">
        <div class="modal-container">
            <div class="modal-header">
                <h3 class="modal-title" id="modalTitle">פרטי קלטת</h3>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="modal-thumbnail">
                    <div class="modal-thumbnail-icon">🎬</div>
                </div>
                <div class="modal-info">
                    <div class="modal-info-grid">
                        <div class="modal-info-item">
                            <div class="modal-info-label">קטגוריה</div>
                            <div class="modal-info-value" id="modalCategory">-</div>
                        </div>
                        <div class="modal-info-item">
                            <div class="modal-info-label">תאריך</div>
                            <div class="modal-info-value" id="modalDate">-</div>
                        </div>
                        <div class="modal-info-item">
                            <div class="modal-info-label">סטטוס</div>
                            <div class="modal-info-value" id="modalStatus">-</div>
                        </div>
                        <div class="modal-info-item" id="modalConverterWrapper">
                            <div class="modal-info-label">בוצע על ידי</div>
                            <div class="modal-info-value" id="modalConverter">-</div>
                        </div>
                    </div>
                </div>
                <div class="modal-description" id="modalDescriptionWrapper">
                    <h4 class="modal-description-title">תיאור הקלטת</h4>
                    <div class="modal-description-content" id="modalDescription">-</div>
                </div>
                <div class="modal-people" id="modalPeopleWrapper">
                    <h4 class="modal-people-title">אנשים בקלטת</h4>
                    <ul class="people-list" id="modalPeopleList">
                        <!-- יתווסף דינמית -->
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <div id="modalStatusBadge" class="gallery-status status-not_edited">לא ערוכה</div>
                <a href="Edit Status.html" class="btn btn-primary">
                    <span class="icon">✏️</span>
                    ערוך קלטת
                </a>
            </div>
        </div>
    </div>

    <script>
        // פונקציה לפתיחת המודל
        function openModal(recordingId) {
            const modal = document.getElementById('recordingModal');
            
            // מידע על הקלטות
            const recordings = {
                '1': {
                    title: 'עמרי בן 3',
                    category: 'משפחה',
                    date: '2025-03-07',
                    status: 'ערוכה',
                    statusClass: 'status-edited',
                    converter: 'עמרי',
                    description: 'הילדים המופעים בקלטת הם איין בן דוד מאמריקה, עמרי בן דוד מישראל, נוי בת דודה מישראל',
                    people: ['איין בן דוד מאמריקה', 'עמרי בן דוד מישראל', 'נוי בת דודה מישראל']
                },
                '2': {
                    title: 'תיבת נגינה מופע סולונה 2011',
                    category: 'אירועים',
                    date: '2025-03-15',
                    status: 'לפני עריכה',
                    statusClass: 'status-before_edit',
                    converter: '',
                    description: 'מופע שירים עם תיבת נגינה',
                    people: ['אייל אבא', 'איתי סלמן', 'עמרי בן אליהו', 'דניאל']
                }
            };
            
            const recording = recordings[recordingId];
            
            if (recording) {
                // עדכון כותרת המודל
                document.getElementById('modalTitle').textContent = recording.title;
                
                // עדכון פרטי המידע
                document.getElementById('modalCategory').textContent = recording.category;
                document.getElementById('modalDate').textContent = recording.date;
                document.getElementById('modalStatus').textContent = recording.status;
                
                // עדכון בוצע על ידי
                const converterWrapper = document.getElementById('modalConverterWrapper');
                if (recording.converter) {
                    document.getElementById('modalConverter').textContent = recording.converter;
                    converterWrapper.style.display = 'block';
                } else {
                    converterWrapper.style.display = 'none';
                }
                
                // עדכון תיאור
                const descriptionWrapper = document.getElementById('modalDescriptionWrapper');
                if (recording.description) {
                    document.getElementById('modalDescription').textContent = recording.description;
                    descriptionWrapper.style.display = 'block';
                } else {
                    descriptionWrapper.style.display = 'none';
                }
                
                // עדכון אנשים בקלטת
                const peopleWrapper = document.getElementById('modalPeopleWrapper');
                const peopleList = document.getElementById('modalPeopleList');
                
                if (recording.people && recording.people.length > 0) {
                    peopleList.innerHTML = '';
                    recording.people.forEach(person => {
                        const li = document.createElement('li');