                    </div>
                    <div class="gallery-content">
                        <h3 class="gallery-title-item">תיבת נגינה מופע סולונה 2011</h3>
                        <div class="gallery-meta">
                            <div class="gallery-meta-item">
                                <span class="icon">📅</span>
                                <span>2025-03-15</span>
                            </div>
                            <div class="gallery-meta-item">
                                <span class="icon">🏷️</span>
                                <span>אירועים</span>
                            </div>
