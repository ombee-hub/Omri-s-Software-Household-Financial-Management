        <main class="main-content">
            <h2 class="page-title">
                <span class="icon">📝</span>
                יומן משימות
            </h2>

            <div class="filters-container">
                <h3 class="filters-title">סינון קלטות</h3>
                <div class="filters">
                    <div class="filter-group">
                        <label for="categoryFilter" class="filter-label">קטגוריה:</label>
                        <select id="categoryFilter" class="filter-control">
                            <option value="">הכל</option>
                            <option value="family">משפחה</option>
                            <option value="friends">חברים</option>
                            <option value="events">אירועים</option>
                            <option value="other">אחר</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="yearFilter" class="filter-label">שנה:</label>
                        <select id="yearFilter" class="filter-control">
                            <option value="">הכל</option>
                            <option value="2025">2025</option>
                            <option value="2024">2024</option>
                            <option value="2023">2023</option>
                            <option value="2022">2022</option>
                            <option value="2020">2020</option>
                        </select>
                    </div>
                    <div class="filter-group">
                        <label for="statusFilter" class="filter-label">סטטוס:</label>
                        <select id="statusFilter" class="filter-control">
                            <option value="">הכל</option>
                            <option value="not_edited">לא ערוכה</option>
                            <option value="before_edit">לפני עריכה</option>
                            <option value="edited">ערוכה</option>
                        </select>
                    </div>
                </div>
                <div class="filter-actions">
                    <button onclick="filterTasks()" class="btn btn-primary">
                        <span class="icon">🔍</span>
                        החל סינון
                    </button>
                </div>
            </div>

            <div class="tasks-grid" id="tasksContainer">
                <!-- קלטת 1 -->
                <div class="task-card">
                    <div class="task-header">
                        <div>
                            <div class="task-title">עמרי בן 3</div>
                            <div class="task-category">משפחה</div>
                        </div>
                        <div class="task-status status-edited">ערוכה</div>
                    </div>
                    <div class="task-body">
                        <div class="task-info">
                            <div class="task-info-item">
                                <span class="task-info-icon">📅</span>
                                <span>2025-03-07</span>
                            </div>
                            <div class="task-info-item">
                                <span class="task-info-icon">🕒</span>
                                <span>10:00</span>
                            </div>
                        </div>
                        <div class="task-description">הילדים המופעים בקלטת הם איין בן דוד מאמריקה, עמרי בן דוד מישראל, נוי בת דודה מישראל</div>
                    </div>
                    <div class="task-footer">
                        <a href="Edit Status.html" class="btn btn-primary btn-sm">
                            <span class="icon">✏️</span>
                            ערוך
                        </a>
                        <a href="details.html" class="btn btn-secondary btn-sm">
                            <span class="icon">📋</span>
                            פרטים
                        </a>
                    </div>
                </div>

                <!-- קלטת 2 -->
                <div class="task-card">
                    <div class="task-header">
                        <div>
                            <div class="task-title">תיבת נגינה מופע סולונה 2011</div>
                            <div class="task-category">אירועים</div>
                        </div>
                        <div class="task-status status-before_edit">לפני עריכה</div>
                    </div>
                    <div class="task-body">
                        <div class="task-info">
                            <div class="task-info-item">
                                <span class="task-info-icon">📅</span>
                                <span>2025-03-15</span>
                            </div>
                            <div class="task-info-item">
                                <span class="task-info-icon">🕒</span>
                                <span>10:00</span>
                            </div>
                        </div>
                        <div class="task-description">מופע שירים עם תיבת נגינה</div>
                    </div>
                    <div class="task-footer">
                        <a href="Edit Status.html" class="btn btn-primary btn-sm">
                            <span class="icon">✏️</span>
                            ערוך
                        </a>
                        <a href="details.html" class="btn btn-secondary btn-sm">
                            <span class="icon">📋</span>
                            פרטים
                        </a>
                    </div>
                </div>
            </div>

            <div class="form-container">
                <div class="form-header">
                    <h3 class="form-title">הוספת קלטת חדשה</h3>
                    <p class="form-subtitle">מלא את הפרטים הבאים כדי להוסיף קלטת חדשה למערכת</p>
                </div>
                <form id="taskForm">
                    <div class="form-body">
                        <div class="form-group">
                            <label for="taskTitle" class="form-label">שם הקלטת:</label>
                            <input type="text" id="taskTitle" class="form-control" required>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="taskCategory" class="form-label">קטגוריה:</label>
                                <select id="taskCategory" class="form-control" required>
                                    <option value="family">משפחה</option>
                                    <option value="friends">חברים</option>
                                    <option value="events">אירועים</option>
                                    <option value="other">אחר</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="taskStatus" class="form-label">סטטוס התחלתי:</label>
                                <select id="taskStatus" class="form-control" required>
                                    <option value="not_edited">לא ערוכה</option>
                                    <option value="before_edit">לפני עריכה</option>
                                    <option value="edited">ערוכה</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="taskDescription" class="form-label">תיאור הקלטת:</label>
                            <textarea id="taskDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="taskDate" class="form-label">תאריך הקלטה:</label>
                                <input type="date" id="taskDate" class="form-control" required>
                            </div>
                            <div class="form-group">
                                <label for="taskTime" class="form-label">שעת הקלטה:</label>
                                <select id="taskTime" class="form-control">
                                    <option value="">בחר שעה</option>
                                    <option value="00:00">00:00</option>
                                    <option value="01:00">01:00</option>
                                    <option value="02:00">02:00</option>
                                    <option value="03:00">03:00</option>
                                    <option value="04:00">04:00</option>
                                    <option value="05:00">05:00</option>
                                    <option value="06:00">06:00</option>
                                    <option value="07:00">07:00</option>
                                    <option value="08:00">08:00</option>
                                    <option value="09:00">09:00</option>
                                    <option value="10:00">10:00</option>
                                    <option value="11:00">11:00</option>
                                    <option value="12:00">12:00</option>
                                    <option value="13:00">13:00</option>
                                    <option value="14:00">14:00</option>
                                    <option value="15:00">15:00</option>
                                    <option value="16:00">16:00</option>
                                    <option value="17:00">17:00</option>
                                    <option value="18:00">18:00</option>
                                    <option value="19:00">19:00</option>
                                    <option value="20:00">20:00</option>
                                    <option value="21:00">21:00</option>
                                    <option value="22:00">22:00</option>
                                    <option value="23:00">23:00</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="taskPeople" class="form-label">אנשים שמופיעים בקלטת:</label>
                            <textarea id="taskPeople" class="form-control" rows="3" placeholder="הזן את שמות האנשים שמופיעים בקלטת, כל שם בשורה חדשה"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="taskConverter" class="form-label">בוצע על ידי:</label>
                            <input type="text" id="taskConverter" class="form-control" placeholder="הזן את שם מבצע ההמרה">
                        </div>
                    </div>
                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <span class="icon">➕</span>
                            הוסף קלטת
                        </button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        // נתוני קלטות לדוגמה (משמשים כאשר אין תקשורת עם השרת)
