// Firestore Security Rules for מערכת החתונה
// Publish with (from the config folder):  npx firebase deploy --only firestore:rules
// or paste into: https://console.firebase.google.com/project/omri-s-software/firestore/rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only these accounts can read or write data. Being logged in is not enough:
    // anyone can create a Firebase account with the public API key, so without
    // this list a stranger could read the guest list and budget.
    // To add someone (e.g. the parents): create the user in Firebase Console →
    // Authentication, add their email here (lowercase), and publish the rules.
    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'omri@household.local',
          'sapir@household.local'
          // 'parent@example.com',
        ];
    }

    match /{document=**} {
      allow read, write: if isMember();
    }

    // ===== Public RSVP page (rsvp.html) - no login =====
    // A guest knows only their own random token (from their personal link).
    // They may read that one doc - never list the collection - and change only
    // their answer, within limits. Everything else stays members-only above.
    match /rsvp/{token} {
      allow get: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'count', 'note', 'respondedAt'])
        && request.resource.data.status in ['yes', 'maybe', 'no']
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= resource.data.invited + 3
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.respondedAt is int;
    }

    // Couple names / date / time / venue for the RSVP page (what an invitation shows)
    match /publicEvent/{doc} {
      allow get: if true;
    }
  }
}
